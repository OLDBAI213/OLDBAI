<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and Exists('$(appdata)\XIVLauncherCN\addon\Hooks\dev\')">$(appdata)\XIVLauncherCN\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.xlcore/dalamud/Hooks/dev/</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev/</DalamudLibPath>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <Import Project="$(DalamudLibPath)/targets/Dalamud.Plugin.targets"/>
</Project>
